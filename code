# ========== AI CHAT ==========
def generate_response_with_speech(model, user_query):
    if "date" in user_query.lower():
        response = f"Today's date is {datetime.now().strftime('%Y-%m-%d')}"
    elif "time" in user_query.lower():
        response = f"The current time is {datetime.now().strftime('%H:%M:%S')}"
    else:
        try:
            response = model.generate_content(user_query).text
        except Exception as e:
            response = f"Error: {e}"
    speak_text(response)
    print("[AI]:", response)

# ========== MAIN HANDLER ==========
def handle_user_input(model, detection_model, cap, query):
    query = query.lower()
    if "scene" in query or "describe" in query or "see" in query:
        describe_scene(model, cap)
    elif "read" in query or "text" in query:
        detect_text_with_gemini(model, cap)
    elif "object" in query:
        object_detection(cap, detection_model)
    elif "where am i" in query or "location" in query:
        speak_location()
    elif "send" in query or "coordinates" in query:
        import asyncio
        asyncio.run(send_location())
    else:
        generate_response_with_speech(model, query)

